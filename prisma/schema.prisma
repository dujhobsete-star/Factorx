generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProxyProtocol {
  HTTP
  HTTPS
  SOCKS4
  SOCKS5
}

enum ProxyStatus {
  PENDING  @map("NEW")
  TESTING
  ACTIVE
  FAILED
  INACTIVE @map("COOLDOWN")
}

enum MaintenanceStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SourceStatus {
  HEALTHY
  DEGRADED
  COOLDOWN
  UNAVAILABLE
}

model Proxy {
  id                    String        @id @default(cuid())
  ip                    String
  port                  Int
  protocol              ProxyProtocol
  username              String?
  password              String?
  country               String?
  countryCode           String?
  city                  String?
  isp                   String?
  anonymity             String?
  source                String
  status                ProxyStatus   @default(PENDING)
  latencyMs             Int?
  sourceLatencyMs       Int?
  sourceUptime          Float?
  sourceLastCheckedAt   DateTime?
  firstSeenAt           DateTime      @default(now())
  lastSeenAt            DateTime      @default(now())
  lastCheckedAt         DateTime?
  lastSuccessfulCheckAt DateTime?
  cooldownUntil         DateTime?
  consecutiveFailures   Int           @default(0)
  successfulChecks      Int           @default(0)
  failedChecks          Int           @default(0)
  lastError              String?
  exitIp                 String?
  countryReported        String?
  countryVerified        String?
  countryVerifiedAt      DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  checks                ProxyCheck[]
  sourceRecords          ProxySourceRecord[]

  @@unique([protocol, ip, port])
  @@index([status])
  @@index([protocol])
  @@index([countryCode])
  @@index([cooldownUntil])
}

model ProxySourceRecord {
  id          String   @id @default(cuid())
  proxyId     String
  source      String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  proxy       Proxy    @relation(fields: [proxyId], references: [id], onDelete: Cascade)

  @@unique([proxyId, source])
  @@index([source])
}

model ProxySourceHealth {
  name                String       @id
  status              SourceStatus @default(HEALTHY)
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  cooldownUntil       DateTime?
  consecutiveFailures Int          @default(0)
  candidatesFetched   Int          @default(0)
  candidatesParsed    Int          @default(0)
  candidatesBR        Int          @default(0)
  candidatesPassed    Int          @default(0)
  averageLatencyMs    Int?
  requestDurationMs   Int?
  lastError           String?
  updatedAt           DateTime     @updatedAt
}

model ProxyCheck {
  id        String   @id @default(cuid())
  proxyId   String
  success   Boolean
  latencyMs Int?
  errorType String?
  checkedAt DateTime @default(now())
  proxy     Proxy    @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  @@index([proxyId, checkedAt])
}

model ProxyMaintenanceRun {
  id                  String            @id @default(cuid())
  startedAt           DateTime          @default(now())
  finishedAt          DateTime?
  initialActiveCount  Int
  retestedCount       Int               @default(0)
  survivedCount       Int               @default(0)
  failedCount         Int               @default(0)
  newCandidatesTested Int               @default(0)
  newProxiesAdded     Int               @default(0)
  candidatesCollected Int              @default(0)
  uniqueCandidates    Int               @default(0)
  rejectedCandidates  Int               @default(0)
  sourceMetrics       Json?
  durationMs          Int?
  finalActiveCount    Int               @default(0)
  status              MaintenanceStatus @default(RUNNING)
  errorMessage        String?
}

model MaintenanceJob {
  id        String    @id @default(cuid())
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  error     String?
  @@index([status, createdAt])
}

model MaintenanceLock {
  name        String   @id
  owner       String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}
