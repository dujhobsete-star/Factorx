generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProxyProtocol {
  HTTP
  HTTPS
  SOCKS4
  SOCKS5
}

enum ProxyStatus {
  NEW
  TESTING
  ACTIVE
  FAILED
  COOLDOWN
}

enum MaintenanceStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Proxy {
  id                    String        @id @default(cuid())
  ip                    String
  port                  Int
  protocol              ProxyProtocol
  country               String?
  countryCode           String?
  city                  String?
  isp                   String?
  anonymity             String?
  source                String
  status                ProxyStatus   @default(NEW)
  latencyMs             Int?
  sourceLatencyMs       Int?
  sourceUptime          Float?
  sourceLastCheckedAt   DateTime?
  firstSeenAt           DateTime      @default(now())
  lastSeenAt            DateTime      @default(now())
  lastCheckedAt         DateTime?
  lastSuccessfulCheckAt DateTime?
  cooldownUntil         DateTime?
  consecutiveFailures   Int           @default(0)
  successfulChecks      Int           @default(0)
  failedChecks          Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  checks                ProxyCheck[]

  @@unique([protocol, ip, port])
  @@index([status])
  @@index([protocol])
  @@index([countryCode])
  @@index([cooldownUntil])
}

model ProxyCheck {
  id        String   @id @default(cuid())
  proxyId   String
  success   Boolean
  latencyMs Int?
  errorType String?
  checkedAt DateTime @default(now())
  proxy     Proxy    @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  @@index([proxyId, checkedAt])
}

model ProxyMaintenanceRun {
  id                  String            @id @default(cuid())
  startedAt           DateTime          @default(now())
  finishedAt          DateTime?
  initialActiveCount  Int
  retestedCount       Int               @default(0)
  survivedCount       Int               @default(0)
  failedCount         Int               @default(0)
  newCandidatesTested Int               @default(0)
  newProxiesAdded     Int               @default(0)
  finalActiveCount    Int               @default(0)
  status              MaintenanceStatus @default(RUNNING)
  errorMessage        String?
}

model MaintenanceJob {
  id        String    @id @default(cuid())
  status    JobStatus @default(PENDING)
  createdAt DateTime  @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  error     String?
  @@index([status, createdAt])
}

model MaintenanceLock {
  name        String   @id
  owner       String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}
